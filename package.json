{
  "name": "@abu24k/v2-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "24K商城 V2 clean-rewrite workspace",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=24.14.0 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "baseline:check": "./scripts/node scripts/check-workspace-baseline.mjs",
    "baseline:test": "./scripts/node --test scripts/check-workspace-baseline.test.mjs",
    "brand:check": "./scripts/node scripts/check-visible-branding.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "contracts:test": "pnpm --filter @abu24k/core contracts:test",
    "requirements:check": "./scripts/node scripts/check-requirements.mjs",
    "database:check": "pnpm --filter @abu24k/core database:check",
    "database:postgres:check": "pnpm --filter @abu24k/core database:postgres:check",
    "api:check": "pnpm --filter @abu24k/core api:check",
    "admin:check": "pnpm --filter @abu24k/platform-admin check",
    "merchant:check": "pnpm --filter @abu24k/merchant check",
    "mall:check": "pnpm --filter @abu24k/mall check",
    "consumer:check": "pnpm --filter @abu24k/core consumer:check",
    "e2e:full": "pnpm --filter @abu24k/core e2e:full",
    "micro:guard:test": "./scripts/node --test scripts/microtest/*.test.mjs platform-v2/scripts/check-mainnet-microtest-cleanup.test.mjs",
    "verify": "pnpm baseline:check && pnpm brand:check && pnpm typecheck && pnpm contracts:test && pnpm requirements:check && pnpm database:check && pnpm database:postgres:check && pnpm api:check && pnpm micro:guard:test && pnpm admin:check && pnpm merchant:check && pnpm mall:check && pnpm consumer:check && pnpm e2e:full",
    "micro:init-env": "./scripts/node scripts/microtest/init-env.mjs",
    "micro:preflight": "./scripts/node scripts/microtest/preflight.mjs",
    "micro:runner": "./scripts/node scripts/microtest/runner.mjs",
    "micro:report": "./scripts/node scripts/microtest/report.mjs",
    "e2e:real-readonly": "pnpm --filter @abu24k/core e2e:real-readonly"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "24.13.3",
    "ethers": "6.17.0",
    "typescript": "6.0.3"
  }
}
