# Combined local development/deployment template. Never load this file in the production API.
# Production API: .env.production.example. Offline deploy/micro-test: .env.deploy.example.
# Expo public values are bundled into the app. Never expose any private key as EXPO_PUBLIC_*.
EXPO_PUBLIC_REOWN_PROJECT_ID=
EXPO_PUBLIC_API_BASE_URL=http://localhost:8787
DAPP_BASE_URL=
DAPP_ENTRY_URL=
DAPP_QR_URL=
EXPO_PUBLIC_BSC_CHAIN_ID=56
EXPO_PUBLIC_BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
EXPO_PUBLIC_BSC_EXPLORER_URL=https://bscscan.com
EXPO_PUBLIC_NPL_BSC_ADDRESS=0x4e8277ab31e4956b2cd48449793a57656dfc03d2
EXPO_PUBLIC_ESCROW_ADDRESS=
EXPO_PUBLIC_SECKILL_ADDRESS=
EXPO_PUBLIC_BNM_BSC_ADDRESS=
EXPO_PUBLIC_REWARD_LEDGER_ADDRESS=
REWARD_LEDGER_ADDRESS=
SECKILL_ADDRESS=
GENESIS_NODE_CONTRACT=
GENESIS_NODE_TOKEN_STANDARD=erc721
# Required only when GENESIS_NODE_TOKEN_STANDARD=erc1155.
GENESIS_NODE_TOKEN_ID=
SECKILL_MAX_GAS_PRICE_WEI=8000000000
ESCROW_OWNER_ADDRESS=
REWARDS_OWNER_ADDRESS=
SECKILL_OWNER_ADDRESS=
ESCROW_SPLIT_VERSION=
RETAINED_NPL_RECEIVER_ADDRESS=
PLATFORM_RECEIVER_ADDRESS=
REGION_RECEIVER_ADDRESS=
REFERRAL_RECEIVER_ADDRESS=
PRIZE_POOL_RECEIVER_ADDRESS=
BURN_RECEIVER_ADDRESS=0x000000000000000000000000000000000000dEaD
CIRCULATION_RECEIVER_ADDRESS=
ESCROW_MERCHANT_BPS=7000
ESCROW_PLATFORM_BPS=1000
ESCROW_REGION_BPS=500
ESCROW_REFERRAL_BPS=500
ESCROW_PRIZE_POOL_BPS=500
ESCROW_BURN_BPS=300
ESCROW_CIRCULATION_BPS=200
# Server-side preferred merchant receiver. Keep real operating addresses in local .env.
MERCHANT_RECEIVER_ADDRESS=
# Optional client-visible merchant receiver. Production still validates the server-side value.
EXPO_PUBLIC_MERCHANT_RECEIVER_ADDRESS=
# Production server values. Use different random values of at least 32 characters.
INDEXER_SECRET=
ADMIN_SECRET=
JWT_SECRET=
LOGISTICS_CALLBACK_SECRET=
ADMIN_WALLET_ADDRESS=
DB_PATH=
AUDIT_DB_PATH=
FRONTEND_URL=http://localhost:8081
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
SIWE_DOMAIN=localhost
SIWE_URI=http://localhost:8081
CHAIN_EVENT_RPC_URL=
ORDER_SIGNER_ADDRESS=
ORDER_SIGNING_WEBHOOK_URL=
ORDER_SIGNING_WEBHOOK_TOKEN=
ORDER_SIGNING_TIMEOUT_MS=10000
# Required provider adapters in production.
AMAP_WEB_SERVICE_KEY=
ELECTRONIC_WAYBILL_WEBHOOK_URL=
ELECTRONIC_WAYBILL_WEBHOOK_TOKEN=
SHIPMENT_WEBHOOK_URL=
SHIPMENT_WEBHOOK_TOKEN=
PRINT_WEBHOOK_URL=
PRINT_WEBHOOK_TOKEN=
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=
# Local-only mock mode. Do not use in production.
ALLOW_UNVERIFIED_CHAIN_EVENTS=false
ESCROW_FROM_BLOCK=
ESCROW_TO_BLOCK=
REWARD_LEDGER_FROM_BLOCK=
REWARD_LEDGER_TO_BLOCK=
SECKILL_FROM_BLOCK=
SECKILL_TO_BLOCK=

# Mainnet micro-test values live in .env only. Never paste PRIVATE_KEY into chat.
TARGET_CHAIN=bsc
CHAIN_ID=56
BSC_RPC_URL=
ETH_RPC_URL=
BASE_RPC_URL=
EXPLORER_API_KEY=REMOVED_FROM_GITHUB
ETHERSCAN_API_KEY=${EXPLORER_API_KEY}
BSCSCAN_API_KEY=${EXPLORER_API_KEY}
BASESCAN_API_KEY=${EXPLORER_API_KEY}
PRIVATE_KEY=
DEV_WALLET=
MARKETING_WALLET=
MICRO_TEST=true
MAX_TX_VALUE_NATIVE=0.0001
MAX_TOTAL_BUDGET_NATIVE=0.001
MAX_GAS_COST_PER_TX_NATIVE=0.0002
MICRO_REWARD_BNM_AMOUNT=0.000001
MICRO_SECKILL_DURATION_SECONDS=3600
MICRO_SECKILL_RELAY_INITIAL_SECONDS=30
MICRO_SECKILL_RELAY_EXTEND_SECONDS=30
MICRO_SECKILL_PRIZE_POOL_NPL=0
