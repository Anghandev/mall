{
  "artifactVersion": "2.0.0-fulfillment-launch.28",
  "protocolVersion": 1,
  "transport": "wss",
  "publicationStatus": "AVAILABLE",
  "endpoint": "/v2/ws",
  "channels": [
    {
      "pattern": "seckill:{sessionId}",
      "authorization": "PUBLIC",
      "events": [
        "SeckillRelayExtended"
      ],
      "replayHttp": "/v2/seckill/sessions/{sessionId}/events"
    }
  ],
  "clientRule": "Bind artifactVersion and channel; resume with the last accepted numeric cursor",
  "envelope": {
    "required": [
      "artifactVersion",
      "protocolVersion",
      "eventId",
      "channel",
      "cursor",
      "eventType",
      "resourceType",
      "resourceId",
      "occurredAt",
      "finality",
      "payload"
    ],
    "properties": {
      "artifactVersion": {
        "const": "2.0.0-fulfillment-launch.28"
      },
      "protocolVersion": {
        "const": 1
      },
      "eventId": {
        "type": "string",
        "minLength": 1
      },
      "channel": {
        "type": "string",
        "minLength": 1
      },
      "cursor": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)$"
      },
      "eventType": {
        "const": "SeckillRelayExtended"
      },
      "resourceType": {
        "type": "string",
        "minLength": 1
      },
      "resourceId": {
        "type": "string",
        "minLength": 1
      },
      "occurredAt": {
        "type": "string",
        "format": "date-time"
      },
      "finality": {
        "const": "FINAL"
      },
      "payload": {
        "type": "object"
      }
    }
  },
  "delivery": {
    "order": "ASCENDING_CURSOR_PER_CHANNEL",
    "deduplicateBy": "eventId",
    "reconnectWith": "lastAcceptedCursor",
    "replay": "AT_LEAST_ONCE",
    "unknownEvent": "FAIL_CLOSED_AND_RESYNC",
    "artifactMismatch": "CLOSE_4409_AND_RELOAD_MANIFEST"
  },
  "closeCodes": {
    "4401": "Unauthorized",
    "4403": "Forbidden",
    "4409": "ArtifactVersionMismatch",
    "4503": "ConfigurationRequired"
  }
}
