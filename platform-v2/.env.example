# Abu 24K Platform V2. Never commit secrets or paste PRIVATE_KEY into chat.
NODE_ENV=development
PORT=8788
CHAIN_ID=56

# Runtime databases must be different absolute paths in production.
DB_PATH=./server/data/platform-v2.db
AUDIT_DB_PATH=./server/data/platform-v2.audit.db

# Authentication and RBAC. Set real secrets locally only.
JWT_SECRET=
ADMIN_BOOTSTRAP_WALLET=
PLATFORM_MULTISIG_ADDRESS=

# BSC RPC. Explorer keys are not RPC URLs.
BSC_RPC_URL=
BSC_FALLBACK_RPC_URL=

# Token and V2 contract addresses.
USDT_ADDRESS=0x55d398326f99059fF775485246999027B3197955
NPL_ADDRESS=0x4e8277ab31e4956b2cd48449793a57656dfc03d2
BNM_V2_ADDRESS=
ESCROW_V2_ADDRESS=
REWARD_LEDGER_V2_ADDRESS=
SECKILL_V2_ADDRESS=

# External settlement executor. The API stores no transaction private key.
SETTLEMENT_EXECUTOR_URL=
SETTLEMENT_EXECUTOR_TOKEN=
SETTLEMENT_REQUIRED_CONFIRMATIONS=15

# Merchant fulfillment providers. Fill real credentials only in local .env or a secret manager.
AMAP_WEB_SERVICE_KEY=
KUAIDI100_CUSTOMER=
KUAIDI100_KEY=
KUAIDI100_SECRET=
KUAIDI100_USER_ID=
KUAIDI100_CALLBACK_SECRET=
FEIE_USER=
FEIE_UKEY=
FEIE_CALLBACK_SECRET=

# Mainnet micro-test defaults.
TARGET_CHAIN=bsc
EXPLORER_API_KEY=REMOVED_FROM_GITHUB
ETHERSCAN_API_KEY=${EXPLORER_API_KEY}
BSCSCAN_API_KEY=${EXPLORER_API_KEY}
BASESCAN_API_KEY=${EXPLORER_API_KEY}
PRIVATE_KEY=
DEV_WALLET=
MARKETING_WALLET=
MICRO_TEST=true
MAX_TX_VALUE_NATIVE=0.0001
MAX_TOTAL_BUDGET_NATIVE=0.001
MAX_GAS_COST_PER_TX_NATIVE=0.0002

# Optional production adapters. Store credentials locally or in a secret manager.
REDIS_URL=
MQ_METRICS_URL=
LOGISTICS_WEBHOOK_URL=
PRINT_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_URL=
OSS_SECRET_REF=
CDN_SECRET_REF=
AI_PROVIDER_SECRET_REF=
