{
  "name": "abu-24k-platform-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Abu 24K merchant workbench V2 with USDT settlement and NPL/BNM rewards.",
  "scripts": {
    "typecheck": "./scripts/node node_modules/typescript/bin/tsc --noEmit",
    "server:dev": "./scripts/node server/index.mjs",
    "contracts:test": "FOUNDRY_ETH_RPC_URL= forge test -vv",
    "contracts:freeze-check": "forge build && ./scripts/node scripts/check-contract-freeze.mjs",
    "requirements:check": "./scripts/node scripts/check-requirements.mjs",
    "database:check": "./scripts/node scripts/check-database.mjs",
    "api:check": "./scripts/node scripts/check-api.mjs",
    "admin:check": "./scripts/node scripts/check-admin.mjs",
    "e2e:full": "./scripts/node scripts/e2e/full-flow.mjs",
    "verify": "pnpm typecheck && pnpm requirements:check && pnpm contracts:test && pnpm database:check && pnpm api:check && pnpm admin:check && pnpm e2e:full",
    "micro:init-env": "./scripts/node scripts/microtest/init-env.mjs",
    "micro:preflight": "./scripts/node scripts/microtest/preflight.mjs",
    "micro:report": "./scripts/node scripts/microtest/report.mjs"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "ethers": "6.17.0",
    "sanitize-html": "2.17.6"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
