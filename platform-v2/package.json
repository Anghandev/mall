{
  "name": "@abu24k/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Abu 24K V2 contracts, server, data and chain workers",
  "scripts": {
    "typecheck": "../scripts/node ../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "contracts:build": "forge build",
    "contracts:artifacts": "../scripts/node scripts/generate-contract-artifacts.mjs",
    "contracts:artifacts:check": "../scripts/node scripts/generate-contract-artifacts.mjs --check",
    "artifacts": "pnpm contracts:artifacts && ../scripts/node scripts/generate-core-artifacts.mjs",
    "artifacts:check": "pnpm contracts:artifacts:check && ../scripts/node scripts/generate-core-artifacts.mjs --check",
    "contracts:test": "forge fmt --check && forge test && ../scripts/node scripts/generate-contract-artifacts.mjs --check",
    "database:check": "../scripts/node --test --test-concurrency=1 server/data/database.test.ts",
    "api:check": "../scripts/node --test --test-concurrency=1 server/api/api.test.ts server/chain/workers.test.ts",
    "consumer:check": "pnpm artifacts:check && ../scripts/node --test --test-concurrency=1 server/api/api.test.ts test/consumer/core-artifacts.test.ts",
    "e2e:full": "../scripts/node --test --test-concurrency=1 test/e2e/combined-v2.test.ts && ../scripts/node ../node_modules/@playwright/test/cli.js test --config test/e2e/playwright.config.ts && pnpm --filter @abu24k/mall test:e2e"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "ethers": "6.17.0",
    "pg": "8.22.0",
    "redis": "6.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@types/pg": "8.20.0",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.14.0 <25"
  }
}
