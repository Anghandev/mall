# Deploy this signer separately from the 24K API. Never place this private key in the API environment.
ORDER_SIGNER_PRIVATE_KEY=
ORDER_SIGNER_ADDRESS=
ORDER_SIGNER_CHAIN_ID=56
ORDER_SIGNER_ESCROW_ADDRESS=
ORDER_SIGNING_WEBHOOK_TOKEN=
# Optional defense in depth. Use the API service's actual source IP when signer and API are on separate hosts.
ORDER_SIGNER_ALLOWED_SOURCES=127.0.0.1
ORDER_SIGNER_HOST=127.0.0.1
ORDER_SIGNER_PORT=8791
ORDER_SIGNER_MAX_BODY_BYTES=16384
